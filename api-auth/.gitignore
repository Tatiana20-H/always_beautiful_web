# ─────────────────────────────────────────────────────────────────────────────
# .gitignore – Always Beautiful Auth API
# Archivos y carpetas que NO deben subirse al repositorio Git
# ─────────────────────────────────────────────────────────────────────────────

# Archivos compilados de Maven
target/
*.class

# Archivos de configuración de IDEs
.idea/
*.iml
.vscode/
*.eclipse

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Logs de la aplicación
*.log
logs/

# Archivos de configuración con datos sensibles (contraseñas de BD)
# En producción usar variables de entorno, no este archivo
# application-prod.properties

# Archivos temporales de Maven
.mvn/timing.properties
