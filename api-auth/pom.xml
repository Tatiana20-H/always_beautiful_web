<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml – Configuración de proyecto Maven para la API de Autenticación
  Always Beautiful - GA7-220501096-AA5-EV01
  Java 17 + Spring Boot 3 + MySQL + Spring Security
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Hereda configuraciones por defecto de Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Coordenadas del proyecto -->
    <groupId>com.beauty</groupId>
    <artifactId>always-beautiful-auth</artifactId>
    <version>1.0.0</version>
    <name>always-beautiful-auth</name>
    <description>API REST de registro e inicio de sesión para Always Beautiful</description>

    <properties>
        <!-- Versión de Java requerida -->
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- ── Spring Web MVC: crea el servidor REST ──────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Spring Data JPA: acceso a base de datos con Hibernate ─────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── Spring Security: BCrypt + control de acceso ───────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ── Bean Validation (Hibernate Validator): @NotBlank, @Email… ─── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Conector MySQL: comunicación Java ↔ MySQL ─────────────────── -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Pruebas unitarias e integración ───────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Plugin para generar el JAR ejecutable con mvn package -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
