    @media (max-width: 760px) { .producto-destacado-inicio { grid-template-columns: minmax(0, 1fr); margin: 42px auto 20px; } .producto-destacado-foto, .producto-destacado-sin-imagen { min-height: 240px; } .descuentos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 540px) { .producto-destacado-inicio, .mejores-descuentos { padding: 22px 16px; width: calc(100% - 28px); } .producto-destacado-foto img { height: min(82vw, 340px); } .descuentos-grid { grid-template-columns: 1fr; } .descuento-imagen { height: 220px; } }
