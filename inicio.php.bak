    .producto-destacado-texto p { color: #75665d; line-height: 1.7; }
    .producto-destacado-meta { color: #743629 !important; font-size: .9rem; font-weight: 700; text-transform: uppercase; }
    .producto-destacado-precio { color: #743629 !important; font: 700 1.55rem Georgia, serif; margin: 16px 0 20px; }
    .producto-destacado-boton { background: #481b18; border-radius: 6px; color: #fffaf7; display: inline-block; font-weight: 700; padding: 12px 18px; text-decoration: none; }
    .producto-destacado-boton:hover { background: #a97878; color: #fff; }
    .producto-destacado-sin-imagen { align-items: center; color: #75665d; display: flex; justify-content: center; min-height: 340px; padding: 20px; text-align: center; }
    .mejores-descuentos { background: linear-gradient(135deg, #f8eee8 0%, #f1e2d9 100%); border: 1px solid #e1c9c0; border-radius: 18px; box-sizing: border-box; margin: 54px auto 46px; max-width: 1180px; padding: clamp(24px, 4vw, 44px); width: calc(100% - 40px); }
    .encabezado-descuentos { margin-bottom: 28px; text-align: center; }
    .encabezado-descuentos h2 { margin: 8px 0 0; }
    .encabezado-descuentos .decoracion-titulo { margin: 10px auto 12px; }
