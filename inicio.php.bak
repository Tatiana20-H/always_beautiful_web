<style>
    .producto-destacado-inicio { align-items: center; background: rgba(255, 248, 242, .78); border: 1px solid rgba(184, 117, 82, .5); border-radius: 18px; box-sizing: border-box; column-gap: clamp(28px, 5vw, 64px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin: 54px auto 20px; max-width: 1120px; overflow: hidden; padding: clamp(22px, 4vw, 46px); row-gap: 10px; width: calc(100% - 40px); }
    .producto-destacado-titulo, .encabezado-descuentos h2 { color: #481b18; font: 700 clamp(1.75rem, 2.4vw, 2.25rem) Georgia, "Times New Roman", serif; line-height: 1.2; margin: 0; text-align: center; text-transform: none; }
    .producto-destacado-titulo { font-size: clamp(2rem, 3.2vw, 2.7rem); grid-column: 1 / -1; text-shadow: 0 1px 0 rgba(255, 255, 255, .7); }
    .decoracion-titulo { align-items: center; color: #a97878; display: flex; gap: 11px; justify-content: center; margin: 8px auto 6px; width: 100%; }
