    .descuento-imagen > a { align-items: center; display: flex; height: 100%; justify-content: center; width: 100%; }
    .descuento-imagen img { box-sizing: border-box; display: block; height: 100%; mix-blend-mode: multiply; object-fit: contain; padding: 18px; width: 100%; }
    .descuento-contenido { align-items: center; display: flex; flex: 1; flex-direction: column; padding: 20px 20px 22px; text-align: center; }
